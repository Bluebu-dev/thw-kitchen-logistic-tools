# Kopiere diese Datei nach .env und setze individuelle, sichere Passwörter.
POSTGRES_DB=thwkueche
POSTGRES_USER=thwkueche
POSTGRES_PASSWORD=HIER_EIN_LANGES_ZUFAELLIGES_DB_PASSWORT_SETZEN
ADMIN_USERNAME=admin
ADMIN_PASSWORD=HIER_EIN_LANGES_ZUFAELLIGES_ADMIN_PASSWORT_SETZEN
WEB_BIND=127.0.0.1
WEB_PORT=8080
# Für HTTPS hinter einem Reverse Proxy auf true setzen
COOKIE_SECURE=false

# Initialer OV-Name; später in der Oberfläche änderbar
OV_NAME=Ortsverband Passau
