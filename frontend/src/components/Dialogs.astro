<dialog id="event-dialog"><form id="event-form"><div class="dialog-head"><h3 id="dialog-title">Neuen Termin anlegen</h3><button type="button" class="icon-button" data-close="event-dialog">✕</button></div><div class="form-grid"><label class="wide">Bezeichnung *<input name="name" required maxlength="150"></label><label>Datum *<input name="date" type="date" required></label><label>Personen<input name="people" type="number" min="0" value="0"></label><label>Verantwortlich<input name="owner" maxlength="120"></label><label>Art<select name="type"><option>Ausgabe</option><option>Zubereitung</option></select></label><label class="wide">Ort<input name="location" maxlength="180"></label></div><div class="dialog-actions"><button type="button" class="btn subtle" data-close="event-dialog">Abbrechen</button><button class="btn primary">Speichern</button></div></form></dialog>
<dialog id="item-dialog"><form id="item-form"><div class="dialog-head"><h3>Zusatzpunkt</h3><button type="button" class="icon-button" data-close="item-dialog">✕</button></div><label>Bezeichnung<input name="label" maxlength="200" required></label><label>Kategorie<select name="category" id="item-category"></select></label><div class="dialog-actions"><button type="button" class="btn subtle" data-close="item-dialog">Abbrechen</button><button class="btn primary">Hinzufügen</button></div></form></dialog>
<dialog id="admin-dialog"><form id="admin-form"><div class="dialog-head"><h3 id="admin-title">Eintrag bearbeiten</h3><button type="button" class="icon-button" data-close="admin-dialog">✕</button></div><div id="admin-fields"></div><div class="dialog-actions"><button type="button" class="btn subtle" data-close="admin-dialog">Abbrechen</button><button class="btn primary">Speichern</button></div></form></dialog>
