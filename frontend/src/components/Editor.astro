<dialog id="editor">
      <form id="editor-form">
        <div class="dialog-head">
          <h2 id="editor-title"></h2>
          <button
            type="button"
            class="icon-button close-editor"
            aria-label="Schließen"
          >
            ✕
          </button>
        </div>
        <div id="editor-fields"></div>
        <p id="editor-error" class="error" role="alert"></p>
        <div class="dialog-actions">
          <button type="button" class="btn subtle close-editor">
            Abbrechen</button
          ><button class="btn primary" id="editor-submit">Speichern</button>
        </div>
      </form>
    </dialog>
