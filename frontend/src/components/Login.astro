<div id="login-screen" class="auth-screen">
      <form id="login-form" class="auth-card">
        <div class="brand-logo">
          <img src="/api/settings/logo" alt="THW-Logo" /><strong class="ov-name"
            >Ortsverband Passau</strong
          >
        </div>
        <h1>Küchenlogistik</h1>
        <p>Einsätze vorbereiten. Vorräte im Blick. Kontrollen dokumentieren.</p>
        <label
          >Benutzername<input
            name="username"
            autocomplete="username"
            required /></label
        ><label
          >Passwort<input
            name="password"
            type="password"
            autocomplete="current-password"
            required /></label
        ><button class="btn primary">Anmelden</button>
        <p id="login-error" class="error" role="alert"></p>
      </form>
    </div>
